    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Giovanni",
    "text": "Pronto? Buongiorno. Sono Giovanni Rossi. Chi parla?",
    "chars": 51
  },
  "L01/02.mp3": {
    "hash": "ff53fb5f381542f9",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Pietro",
    "text": "Pronto! Sono Pietro.",
    "chars": 20
  },
  "L01/03.mp3": {
    "hash": "295847cd6aedfc88",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Giovanni",
    "text": "Ciao, Pietro.",
    "chars": 13
  },
  "L01/04.mp3": {
    "hash": "f797dceb445bfc80",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Pietro",
    "text": "Ciao, Giovanni.",
    "chars": 15
  },
  "L01/05.mp3": {
    "hash": "a86d6e3622414c47",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Giovanni",
    "text": "Come stai?",
    "chars": 10
  },
  "L01/06.mp3": {
    "hash": "1495d8c0ffa2f697",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Pietro",
    "text": "Bene, grazie. E tu?",
    "chars": 19
  },
  "L01/07.mp3": {
    "hash": "2aa2553a22914a5a",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Giovanni",
    "text": "Bene, grazie. Anch'io sto bene.",
    "chars": 31
  },
  "L01/08.mp3": {
    "hash": "a82deda5eebc36a1",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Pietro",
    "text": "Che mi racconti?",
    "chars": 16
  },
  "L01/09.mp3": {
    "hash": "1ef407150e12b67f",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Giovanni",
    "text": "Niente. Fa bel tempo. E lì che mi racconti?",
    "chars": 43
  },
  "L01/10.mp3": {
    "hash": "a94d0f38e1d58813",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Pietro",
    "text": "Niente di particolare. Anche qui fa bel tempo.",
    "chars": 46
  },
  "L01/lesson.mp3": {
    "hash": "39155a74fb227673",
    "voice": "",
    "who": "",
    "text": "11 parti",
    "chars": 0
  },
  "L01/title.mp3": {
    "hash": "808779804886da6a",
    "voice": "aXHehUlg30OAHs2yeSFp",
    "who": "Narratore",
    "text": "Lezione uno. Che mi racconti? Niente.",
    "chars": 37
  },
  "L02/01.mp3": {
    "hash": "89c3ceef0e8ddee7",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Professore",
    "text": "Questa è l'Europa.",
    "chars": 18
  },
  "L02/02.mp3": {
    "hash": "c0121f16a280a5b9",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Professore",
    "text": "Qui c'è l'Ungheria.",
    "chars": 19
  },
  "L02/03.mp3": {
    "hash": "bfc047a09cd21ac7",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Professore",
    "text": "Lì c'è l'Italia.",
    "chars": 16
  },
  "L02/04.mp3": {
    "hash": "4e9be887ce73cfed",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Professore",
    "text": "L'Ungheria è un paese grande.",
    "chars": 29
  },
  "L02/05.mp3": {
    "hash": "534a8d4e14f3a897",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Pierino",
    "text": "Professore, anche l'Italia è un paese grande?",
    "chars": 45
  },
  "L02/06.mp3": {
    "hash": "f2431349265d8439",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Professore",
    "text": "Sì, Pierino, anche l'Italia è un paese grande.",
    "chars": 46
  },
  "L02/07.mp3": {
    "hash": "b4d661762a85f4d0",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Professore",
    "text": "In Ungheria ci sono gli ungheresi e parlano ungherese.",
    "chars": 54
  },
  "L02/08.mp3": {
    "hash": "63f89ebeda30404a",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Professore",
    "text": "In Italia ci sono gli italiani e parlano italiano.",
    "chars": 50
  },
  "L02/09.mp3": {
    "hash": "83fbb7693369881c",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Professore",
    "text": "Qui c'è Budapest e lì c'è Roma.",
    "chars": 31
  },
  "L02/10.mp3": {
    "hash": "798255f41d550ac0",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Professore",
    "text": "Budapest è una bella città.",
    "chars": 27
  },
  "L02/11.mp3": {
    "hash": "7facb20088144d60",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Pierino",
    "text": "Professore, anche Roma è una bella città?",
    "chars": 41
  },
  "L02/12.mp3": {
    "hash": "55775fbb25b16bf8",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Professore",
    "text": "Sì, Pierino, anche Roma è una città bella e grande.",
    "chars": 51
  },
  "L02/13.mp3": {
    "hash": "5ed6cdbc03a1da8e",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Professore",
    "text": "Noi non siamo italiani. Noi siamo ungheresi e parliamo ungherese.",
    "chars": 65
  },
  "L02/lesson.mp3": {
    "hash": "b8f9454c54dc9e80",
    "voice": "",
    "who": "",
    "text": "14 parti",
    "chars": 0
  },
  "L02/title.mp3": {
    "hash": "93e66e2eb1cd8e55",
    "voice": "aXHehUlg30OAHs2yeSFp",
    "who": "Narratore",
    "text": "Lezione due. L'Ungheria, l'Italia.",
    "chars": 34
  },
  "L03/01.mp3": {
    "hash": "5342ae86a93de979",
    "voice": "aXHehUlg30OAHs2yeSFp",
    "who": "Narratore",
    "text": "La famiglia Rossi vive a Roma",
    "chars": 29
  },
  "L03/02.mp3": {
    "hash": "76eaecc447027374",
    "voice": "aXHehUlg30OAHs2yeSFp",
    "who": "Narratore",
    "text": "in un appartamento moderno.",
    "chars": 27
  },
  "L03/03.mp3": {
    "hash": "406cd3de6cc9a9d8",
    "voice": "aXHehUlg30OAHs2yeSFp",
    "who": "Narratore",
    "text": "I Rossi sono a casa.",
    "chars": 20
  },
  "L03/04.mp3": {
    "hash": "30fca933c89f598e",
    "voice": "MxbaIHXywTPlbmHYvbPn",
    "who": "Narratrice",
    "text": "Dov'è Giovanni Rossi?",
    "chars": 21
  },
  "L03/05.mp3": {
    "hash": "34a2a153eea0ab98",
    "voice": "aXHehUlg30OAHs2yeSFp",
    "who": "Narratore",
    "text": "È in cucina.",
    "chars": 12
  },
  "L03/06.mp3": {
    "hash": "39d26e5c4edaddc7",
    "voice": "MxbaIHXywTPlbmHYvbPn",
    "who": "Narratrice",
    "text": "Dov'è la signora Rossi?",
    "chars": 23
  },
  "L03/07.mp3": {
    "hash": "4d8c14e6e320e086",
    "voice": "aXHehUlg30OAHs2yeSFp",
    "who": "Narratore",
    "text": "In camera.",
    "chars": 10
  },
  "L03/08.mp3": {
    "hash": "2ad3669a29f2f983",
    "voice": "MxbaIHXywTPlbmHYvbPn",
    "who": "Narratrice",
    "text": "Un marito in cucina?",
    "chars": 20
  },
  "L03/09.mp3": {
    "hash": "8d6fb53609580457",
    "voice": "MxbaIHXywTPlbmHYvbPn",
    "who": "Narratrice",
    "text": "Una moglie in camera?",
    "chars": 21
  },
  "L03/10.mp3": {
    "hash": "1cffafcb9c054623",
    "voice": "MxbaIHXywTPlbmHYvbPn",
    "who": "Narratrice",
    "text": "Non è strano?",
    "chars": 13
  },
  "L03/11.mp3": {
    "hash": "48b198b153c2cc59",
    "voice": "aXHehUlg30OAHs2yeSFp",
    "who": "Narratore",
    "text": "No.",
    "chars": 3
  },
  "L03/lesson.mp3": {
    "hash": "f96ce66ab4055ff7",
    "voice": "",
    "who": "",
    "text": "12 parti",
    "chars": 0
  },
  "L03/title.mp3": {
    "hash": "c0baffb4b20c0cc1",
    "voice": "aXHehUlg30OAHs2yeSFp",
    "who": "Narratore",
    "text": "Lezione tre. Una strana famiglia.",
    "chars": 33
  },
  "L04/01.mp3": {
    "hash": "24ef64558849b949",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Poliziotto",
    "text": "Lei è straniero? Cosa fa in Italia?",
    "chars": 35
  },
  "L04/02.mp3": {
    "hash": "a902b11872b18167",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Straniero",
    "text": "Studio l'italiano.",
    "chars": 18
  },
  "L04/03.mp3": {
    "hash": "71b8dcd53cba61c2",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Poliziotto",
    "text": "È difficile la lingua italiana?",
    "chars": 31
  },
  "L04/04.mp3": {
    "hash": "cfb1d58dde397e8e",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Straniero",
    "text": "No, è facile.",
    "chars": 13
  },
  "L04/05.mp3": {
    "hash": "135051d0715e2e77",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Poliziotto",
    "text": "Dove vive? A Budapest?",
    "chars": 22
  },
  "L04/06.mp3": {
    "hash": "7d6a9b225e4cee14",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Straniero",
    "text": "Non vivo a Budapest, ma in una cittadina ungherese.",
    "chars": 51
  },
  "L04/07.mp3": {
    "hash": "42fb519d2b47b71e",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Poliziotto",
    "text": "E adesso dove va?",
    "chars": 17
  },
  "L04/08.mp3": {
    "hash": "19511103db9706f0",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Straniero",
    "text": "Vado in albergo.",
    "chars": 16
  },
  "L04/09.mp3": {
    "hash": "07a96355e44acfa9",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Poliziotto",
    "text": "Arrivederci. Buona giornata.",
    "chars": 28
  },
  "L04/lesson.mp3": {
    "hash": "03d44a3eef082868",
    "voice": "",
    "who": "",
    "text": "10 parti",
    "chars": 0
  },
  "L04/title.mp3": {
    "hash": "eb9d972bce202a30",
    "voice": "aXHehUlg30OAHs2yeSFp",
    "who": "Narratore",
    "text": "Lezione quattro. Un poliziotto curioso.",
    "chars": 39
  },
  "L05/01.mp3": {
    "hash": "98e59ca085a25d63",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Cliente",
    "text": "Cameriere! Il menù, per favore!",
    "chars": 31
  },
  "L05/02.mp3": {
    "hash": "4df653be688804d7",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Cameriere",
    "text": "Arrivo subito… Ecco a Lei.",
    "chars": 26
  },
  "L05/03.mp3": {
    "hash": "24827305831f53de",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Cliente",
    "text": "Grazie.",
    "chars": 7
  },
  "L05/04.mp3": {
    "hash": "48eed5b7d9c307ce",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Cameriere",
    "text": "Cosa prendete da bere?",
    "chars": 22
  },
  "L05/05.mp3": {
    "hash": "9dbd0033ecd5c4f5",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Cliente",
    "text": "Un litro di vino rosso.",
    "chars": 23
  },
  "L05/06.mp3": {
    "hash": "c337db75dcee6e0e",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Cameriere",
    "text": "Abbiamo solo vino bianco.",
    "chars": 25
  },
  "L05/07.mp3": {
    "hash": "e64dfca37f102d7f",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Cliente",
    "text": "Va bene. Ma vogliamo anche dell'acqua. Avete le lasagne?",
    "chars": 56
  },
  "L05/08.mp3": {
    "hash": "8a1b82175f5d50d1",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Cameriere",
    "text": "Sì, signore. Le abbiamo. E abbiamo anche il pollo arrosto.",
    "chars": 58
  },
  "L05/09.mp3": {
    "hash": "f1265b210b46350c",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Cliente",
    "text": "Prendiamo due lasagne e un pollo arrosto.",
    "chars": 41
  },
  "L05/10.mp3": {
    "hash": "3169f096f6786dd2",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Cameriere",
    "text": "Porto anche un'insalata.",
    "chars": 24
  },
  "L05/11.mp3": {
    "hash": "55a2b97ee6a8cd6a",
    "voice": "S7L0uJpUCUDUktI3y5cw",
    "who": "Cliente",
    "text": "No, l'insalata non la vogliamo.",
    "chars": 31
  },
  "L05/12.mp3": {
    "hash": "019cfea738e7bce2",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Cameriere",
    "text": "Buon appetito!",
    "chars": 14
  },
  "L05/lesson.mp3": {
    "hash": "e3e44b73a59484a1",
    "voice": "",
    "who": "",
    "text": "13 parti",
    "chars": 0
  },
  "L05/title.mp3": {
    "hash": "8936525eb4736c8e",
    "voice": "aXHehUlg30OAHs2yeSFp",
    "who": "Narratore",
    "text": "Lezione cinque. Al ristorante «Da Mario».",
    "chars": 41
  },
  "L06/01.mp3": {
    "hash": "54107e1a3d658750",
    "voice": "wOXFTxgu7FQDBb1dsL7I",
    "who": "Donna",
    "text": "Gigi, vieni a fare una passeggiata?",
    "chars": 35
  },
  "L06/02.mp3": {
    "hash": "1d98954ecf5a6e44",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Gigi",
    "text": "No, adesso non ho tempo.",
    "chars": 24
  },
  "L06/03.mp3": {
    "hash": "53114908d3eb0bb2",
    "voice": "wOXFTxgu7FQDBb1dsL7I",
    "who": "Donna",
    "text": "Perché? Cosa fai?",
    "chars": 17
  },
  "L06/04.mp3": {
    "hash": "2438fe50947786b0",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Gigi",
    "text": "Studio l'ungherese.",
    "chars": 19
  },
  "L06/05.mp3": {
    "hash": "619942051cf41b75",
    "voice": "wOXFTxgu7FQDBb1dsL7I",
    "who": "Donna",
    "text": "È bello il libro?",
    "chars": 17
  },
  "L06/06.mp3": {
    "hash": "2e02ffdb0f2173a1",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Gigi",
    "text": "Molto interessante. Il suo titolo è: «Il rosso e il nero».",
    "chars": 58
  },
  "L06/07.mp3": {
    "hash": "c98a29dd63c9167b",
    "voice": "wOXFTxgu7FQDBb1dsL7I",
    "who": "Donna",
    "text": "Bene, allora non facciamo la passeggiata, leggo anch'io. Dov'è il mio libro?",
    "chars": 76
  },
  "L06/08.mp3": {
    "hash": "d1102215bf2f95f2",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Gigi",
    "text": "Eccolo, è sul tavolo. Il titolo è interessante:",
    "chars": 47
  },
  "L06/09.mp3": {
    "hash": "2a9c7b3d08901a70",
    "voice": "kmhW33fhWZsJVeOyIdMz",
    "who": "Gigi",
    "text": "«Il poliziotto, sua moglie e il basilico».",
    "chars": 42
  },
  "L06/lesson.mp3": {
